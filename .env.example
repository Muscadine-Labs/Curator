# Copy to .env.local — never commit real keys

# Required in production
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Recommended
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
# COINBASE_CDP_API_KEY=
# NEXT_PUBLIC_SAFE_API_KEY=
# CURATOR_ADMIN_PASSWORD=
# Dedicated HMAC secret for curator_session (required in production)
# CURATOR_SESSION_SECRET=
# Bump to invalidate all sessions without changing the password
# CURATOR_SESSION_VERSION=1
# MORPHO_API_URL=

# Optional vault address overrides
# NEXT_PUBLIC_VAULT_USDC_V2=
# NEXT_PUBLIC_VAULT_WETH_V2=
# NEXT_PUBLIC_VAULT_CBBTC_V2=
# NEXT_PUBLIC_VAULT_USDC_V2_FRONTIER=
# NEXT_PUBLIC_VAULT_CBBTC_V2_TEST=
# NEXT_PUBLIC_VAULT_USDC_V2_TEST=
